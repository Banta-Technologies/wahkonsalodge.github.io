---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  additionalStructuredData?: Record<string, unknown>[];
  preloadImage?: {
    href: string;
    srcset?: string;
    sizes?: string;
    type?: string;
  };
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const defaultDescription =
  "Meet Noni and Papa in a warm country comic about married life, fishing, gardening, aging, simple living, and the humor found in everyday moments.";

const {
  title,
  description = defaultDescription,
  image = "/images/noni-and-papa/banner-evolved.png",
  imageAlt = "Wahkonsa Lodge, home of Noni and Papa, beside a lake and rustic farmhouse",
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  additionalStructuredData = [],
  preloadImage,
} = Astro.props;

const resolvedImageWithDomain = new URL(image, Astro.site).toString();

const makeTitle = title
  ? title + " | " + "Wahkonsa Lodge"
  : "Wahkonsa Lodge | Home of Noni & Papa";

const pageSchemaType = type === "article" ? "BlogPosting" : "WebPage";
const isHomePage = Astro.url.pathname === "/";
const breadcrumbStructuredData = !isHomePage
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: Astro.site?.toString(),
        },
        {
          "@type": "ListItem",
          position: 2,
          name: title ?? "Wahkonsa Lodge",
          item: canonicalURL,
        },
      ],
    }
  : null;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Wahkonsa Lodge",
    url: Astro.site?.toString(),
    description: defaultDescription,
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Wahkonsa Lodge",
    url: Astro.site?.toString(),
    logo: new URL(
      "/images/site/wahkonsa-lodge-logo.png",
      Astro.site,
    ).toString(),
  },
  {
    "@context": "https://schema.org",
    "@type": pageSchemaType,
    name: makeTitle,
    headline: makeTitle,
    url: canonicalURL,
    description,
    image: resolvedImageWithDomain,
    ...(author ? { author: { "@type": "Person", name: author } } : {}),
    ...(publishedTime ? { datePublished: publishedTime } : {}),
    ...(modifiedTime ? { dateModified: modifiedTime } : {}),
    ...(tags.length ? { keywords: tags.join(", ") } : {}),
  },
  ...(breadcrumbStructuredData ? [breadcrumbStructuredData] : []),
  ...additionalStructuredData,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type}
          fetchpriority="high"
        />
      )
    }

    <!-- SEO -->
    <SEO
      title={makeTitle}
      description={description}
      canonical={canonicalURL}
      noindex={noindex}
      robotsExtras="max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      twitter={{
        card: "summary_large_image",
        title: makeTitle,
        description,
        image: resolvedImageWithDomain,
        imageAlt,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type,
          title: makeTitle,
          image: resolvedImageWithDomain,
        },
        optional: {
          description,
          locale: "en_US",
          siteName: "Wahkonsa Lodge",
        },
        image: {
          secureUrl: resolvedImageWithDomain,
          alt: imageAlt,
        },
        ...(type === "article"
          ? {
              article: {
                publishedTime,
                modifiedTime,
                authors: author ? [author] : undefined,
                tags,
              },
            }
          : {}),
      }}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-2Q5FRRB9LE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-2Q5FRRB9LE");
    </script>
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }

      body {
        background:
          linear-gradient(
            180deg,
            rgba(250, 247, 239, 0.86),
            rgba(255, 255, 255, 0.96) 28rem
          ),
          #fff;
      }
    </style>
  </body>
</html>
