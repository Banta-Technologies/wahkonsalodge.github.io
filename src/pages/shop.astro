---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";

const amazonNoniPapaCountryLifeLogoBaseballHatUrl =
  "https://www.amazon.com/dp/B0HGYJFM15";
const amazonNoniPapaCountryLifeTumblerUrl =
  "https://www.amazon.com/dp/B0HGSC45CW";
const amazonNoniPapaFlowerCartTumblerUrl =
  "https://www.amazon.com/dp/B0HGMF1ZBW";
const amazonNoniPapaGoneFishinTumblerUrl =
  "https://www.amazon.com/dp/B0HGGLLBLX";
const amazonNoniPapaDonkeyWisdomTumblerUrl =
  "https://www.amazon.com/dp/B0HGBL2PDS";
const amazonWahkonsaLodgeHomesteadUrl = "https://www.amazon.com/dp/B0HH7H8WF4";
const amazonNoniPapaWilliamTheGoatUrl = "https://www.amazon.com/dp/B0HH4133XK";

const featuredProducts = [
  {
    title: "Noni & Papa Country Life Logo Adjustable Baseball Hat",
    text: "The original Noni & Papa logo featuring their smiling donkey mascot and classic rustic country style.",
    href: amazonNoniPapaCountryLifeLogoBaseballHatUrl,
    image: "/images/shop/noni-papa-country-life-logo-baseball-hat-amazon.png",
    source: "Amazon",
  },
  {
    title: "Noni & Papa Country Life Tumbler",
    text: "Noni enjoys her flower garden on one side while Papa takes life easy with his dog and fishing gear on the other.",
    href: amazonNoniPapaCountryLifeTumblerUrl,
    image: "/images/shop/noni-papa-country-life-tumbler-amazon.png",
    source: "Amazon",
  },
  {
    title: "Noni & Papa Flower Cart Tumbler",
    text: "Noni rides in Papa's homemade sapling cart overflowing with garden flowers and pulled by their trusty goat.",
    href: amazonNoniPapaFlowerCartTumblerUrl,
    image: "/images/shop/noni-papa-flower-cart-tumbler-amazon.png",
    source: "Amazon",
  },
  {
    title: "Noni & Papa Gone Fishin' Tumbler",
    text: "Papa has his priorities straight - a fishing pole, a quiet afternoon, and his homemade GOOD ENUF fishing boat.",
    href: amazonNoniPapaGoneFishinTumblerUrl,
    image: "/images/shop/noni-papa-gone-fishin-tumbler-amazon.png",
    source: "Amazon",
  },
  {
    title: "Noni & Papa Donkey Wisdom Tumbler",
    text: 'The wisecracking Noni & Papa donkey shares a little country wisdom with his signature gold tooth and "What a Sap!" attitude.',
    href: amazonNoniPapaDonkeyWisdomTumblerUrl,
    image: "/images/shop/noni-papa-donkey-wisdom-tumbler-amazon.png",
    source: "Amazon",
  },
  {
    title: "Wahkonsa Lodge Homestead",
    text: "A peaceful view down the dirt road at Wahkonsa Lodge, where country life moves a little slower.",
    href: amazonWahkonsaLodgeHomesteadUrl,
    image: "/images/shop/wahkonsa-lodge-homestead-amazon.png",
    source: "Amazon",
  },
  {
    title: "Noni & Papa William the Goat",
    text: "William the goat stands proudly among the wildflowers at Wahkonsa Lodge, looking innocent for once.",
    href: amazonNoniPapaWilliamTheGoatUrl,
    image: "/images/shop/noni-papa-william-the-goat-amazon.png",
    source: "Amazon",
  },
];
---

<Layout
  title="Shop Wahkonsa Lodge"
  description="Shop featured Noni & Papa gifts, apparel, tumblers, and country-life merchandise from Wahkonsa Lodge.">
  <Container>
    <main class="py-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900">
          Shop Wahkonsa Lodge
        </h1>
        <p class="mt-3 text-lg leading-8 text-slate-600">
          Browse featured Wahkonsa Lodge products, gifts, apparel, and home
          goods.
        </p>
      </div>

      <section class="mt-10" aria-labelledby="featured-products-title">
        <h2
          id="featured-products-title"
          class="text-2xl font-bold tracking-tight text-slate-900">
          Featured Products
        </h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            featuredProducts.map((product) => (
              <a
                href={product.href}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="group rounded-lg border border-slate-200 bg-white p-3 shadow-sm transition hover:-translate-y-0.5 hover:border-teal-200 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2">
                <div class="aspect-[4/3] overflow-hidden rounded-md bg-slate-50">
                  <img
                    src={product.image}
                    alt={product.title}
                    loading="lazy"
                    class="h-full w-full object-contain transition duration-200 group-hover:scale-[1.02]"
                  />
                </div>
                <h3 class="mt-3 text-base font-semibold text-slate-900">
                  {product.title}
                </h3>
                <p class="mt-1 text-sm leading-6 text-slate-600">
                  {product.text}
                </p>
                <p class="mt-3 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-center text-xs font-semibold text-teal-700 transition group-hover:border-teal-200 group-hover:bg-teal-50">
                  View on {product.source}
                </p>
              </a>
            ))
          }
        </div>
      </section>
    </main>
  </Container>
</Layout>
