    "B0HJ69ZJQ6",
    "B0HJHY6QWB",
    "B0HJM4JWHT",
  ]),
};

const shopSections = [
  {
    id: "seasonal-products-title",
    title: featuredSeasonalCollection.title,
    products: featuredProducts.filter((product) =>
      featuredSeasonalCollection.productAsins.has(product.asin),
    ),
  },
  {
    id: "evergreen-products-title",
    title: "Noni & Papa Merchandise",
    products: featuredProducts.filter(
      (product) => !featuredSeasonalCollection.productAsins.has(product.asin),
    ),
  },
];
---

<Layout
  title="Shop Wahkonsa Lodge"
  description="Shop featured Noni & Papa gifts, apparel, tumblers, and country-life merchandise from Wahkonsa Lodge.">
  <Container>
    <main class="py-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900">
          Shop Wahkonsa Lodge
        </h1>
        <p class="mt-3 text-lg leading-8 text-slate-600">
          Browse featured Wahkonsa Lodge products, gifts, apparel, and home
          goods.
        </p>
      </div>

      {shopSections.map((section, index) => (
        <section
          class:list={[
            "mt-10",
            index === 0 &&
              "rounded-xl border border-slate-200 bg-slate-50 p-4 sm:p-6",
          ]}
          aria-labelledby={section.id}>
          <h2
            id={section.id}
            class="text-2xl font-bold tracking-tight text-slate-900">
            {section.title}
          </h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {section.products.map((product) => (
              <a
                href={product.href}
                target="_blank"
                rel="noopener noreferrer sponsored"
                data-amazon-product
                data-product-title={product.title}
                data-asin={product.asin}
                class="group rounded-lg border border-slate-200 bg-white p-3 shadow-sm transition hover:-translate-y-0.5 hover:border-teal-200 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2">
                <div class="aspect-[4/3] overflow-hidden rounded-md bg-slate-50">
                  <img
                    src={product.image}
                    alt={product.title}
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain transition duration-200 group-hover:scale-[1.02]"
                  />
                </div>
                <h3 class="mt-3 text-base font-semibold text-slate-900">
                  {product.title}
                </h3>
                <p class="mt-1 text-sm leading-6 text-slate-600">
                  {product.text}
                </p>
                <p class="mt-3 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-center text-xs font-semibold text-teal-700 transition group-hover:border-teal-200 group-hover:bg-teal-50">
                  View on {product.source}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>
  </Container>
  <script>
    type Gtag = (
      command: "event",
      eventName: string,
      eventParameters: Record<string, string>,
    ) => void;

    const googleTaggedWindow = window as Window & { gtag?: Gtag };

    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest<HTMLAnchorElement>(
        "a[data-amazon-product]",
      );
      if (!link) return;

      const { productTitle, asin } = link.dataset;
      if (
        !productTitle ||
        !asin ||
        typeof googleTaggedWindow.gtag !== "function"
      ) {
        return;
      }

      googleTaggedWindow.gtag("event", "amazon_outbound_click", {
        product_title: productTitle,
        asin,
        link_url: link.href,
      });
    });
  </script>
</Layout>
