---
import CollectionGallery from "@components/collection-gallery.astro";
import Container from "@components/container.astro";
import Hero from "@components/hero.astro";
import Layout from "@layouts/Layout.astro";
import { latestNoniAndPapaSlug, noniAndPapaItems } from "../data/noni-and-papa";

const homeDescription =
  "Meet Noni and Papa in a warm country comic about married life, fishing, gardening, aging, simple living, and the humor found in everyday moments.";
const latestComic = noniAndPapaItems.find((comic) => {
  const filename = comic.image.split("/").at(-1) ?? "";
  const assetSlug = filename.replace(/\.[^.]+$/, "");
  const logicalSlug =
    "version" in comic
      ? assetSlug.replace(new RegExp(`-v${comic.version}$`), "")
      : assetSlug;
  return logicalSlug === latestNoniAndPapaSlug;
});

if (!latestComic) {
  throw new Error(
    `Latest Noni & Papa comic not found: ${latestNoniAndPapaSlug}`,
  );
}
const comicStructuredData = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: "Noni & Papa",
  description: homeDescription,
  url: new URL("/noni-and-papa/", Astro.site).toString(),
  image: new URL(latestComic.image, Astro.site).toString(),
  genre: ["Comics", "Country humor", "Family humor"],
  creator: {
    "@type": "Organization",
    name: "Wahkonsa Lodge",
    url: Astro.site?.toString(),
  },
};
---

<Layout
  description={homeDescription}
  additionalStructuredData={[comicStructuredData]}>
  <Container>
    <Hero />

    <main class="mx-auto max-w-5xl pb-14">
      <section
        class="mx-auto max-w-4xl text-center"
        aria-labelledby="home-title">
        <h1
          id="home-title"
          class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Wahkonsa Lodge — Home of Noni &amp; Papa
        </h1>
        <p class="mx-auto mt-5 max-w-3xl text-lg leading-8 text-slate-600">
          Welcome to the home of Noni &amp; Papa, a warm, humorous comic
          inspired by everyday married life, country living, fishing, gardening,
          aging, simple pleasures, and the gentle humor hiding in ordinary days.
        </p>
        <p class="mt-4 text-xl font-semibold italic text-amber-900">
          Life ain't fancy. That's half the fun.
        </p>
      </section>

      <section
        class="mt-16 border-t border-slate-200 pt-10"
        aria-labelledby="latest-comic-title">
        <div class="max-w-3xl">
          <p
            class="text-sm font-semibold uppercase tracking-wider text-teal-700">
            Fresh from the lodge
          </p>
          <h2
            id="latest-comic-title"
            class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
            Latest Noni &amp; Papa Comic
          </h2>
          <p class="mt-3 text-base leading-7 text-slate-600">
            Catch up with the latest bit of country wisdom, married-life
            mischief, and good-natured trouble from Noni and Papa.
          </p>
        </div>

        <CollectionGallery
          items={[latestComic]}
          action="Read this comic"
          featured={true}
        />

        <a
          href="/noni-and-papa"
          class="mt-6 inline-flex rounded-md bg-teal-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-teal-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2">
          Browse the Noni &amp; Papa comic archive
        </a>
      </section>

      <section
        class="mt-16 rounded-xl border border-amber-900/15 bg-amber-50/70 p-6 shadow-sm sm:p-8"
        aria-labelledby="meet-title">
        <h2
          id="meet-title"
          class="text-3xl font-bold tracking-tight text-slate-900">
          Meet Noni &amp; Papa
        </h2>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">
          Papa brings fishing stories, practical ideas, and the occasional
          questionable plan. Noni keeps life moving with warmth, wit, and a
          clear eye for nonsense. Their wisecracking, gold-toothed donkey is
          rarely far away—or short on opinions.
        </p>
      </section>

      <section class="mt-16" aria-labelledby="around-lodge-title">
        <div class="max-w-3xl">
          <h2
            id="around-lodge-title"
            class="text-3xl font-bold tracking-tight text-slate-900">
            Around the Lodge
          </h2>
          <p class="mt-3 text-base leading-7 text-slate-600">
            Take a little Noni &amp; Papa country humor home with gifts inspired
            by life around the lodge.
          </p>
        </div>

        <div class="mt-6 max-w-xl">
          <a
            href="/shop"
            class="rounded-lg border border-slate-200 bg-white p-5 transition hover:border-teal-200 hover:bg-teal-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2">
            <h3 class="text-lg font-semibold text-slate-900">Gift Shop</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Take a little Wahkonsa Lodge humor and artwork home with you.
            </p>
          </a>
        </div>
      </section>
    </main>
  </Container>
</Layout>
